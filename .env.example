# Copia este archivo a .env (nunca subas .env a git).

# --- Frontend (Vite) — públicas, van al navegador. Solo la clave anon/publishable, NUNCA la service role. ---
VITE_SUPABASE_URL=https://cwyrsqhoqieaamfgbuyb.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Backend (endpoints /api/* — Cloudflare Pages Functions o Netlify Functions) ---
# SECRETAS, nunca en el navegador ni en git.
# Dashboard Supabase → Project Settings → API → "service_role" secret.
SUPABASE_SERVICE_ROLE_KEY=
# En Cloudflare Pages estas dos se cargan como secrets del proyecto, no desde .env:
#   npx wrangler pages secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler pages secret put SUPABASE_URL
SUPABASE_URL=

# --- Solo para scripts/migrate.mjs y scripts/run-sql.mjs (local, nunca en producción). ---
# Dashboard Supabase → Project Settings → Database → Connection string → URI.
DATABASE_URL=
